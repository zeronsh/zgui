---
// The home page (design/BRIEF.md). Static HTML and CSS; small scripts for the
// theme toggle, sections fading in, and the chart's entrance. Its samples are
// getting started's, its numbers the published benchmark's, its doc sets the
// manifest's, its version crates.io's.
import { Box, FileCode, MonitorSmartphone, SquareTerminal, Gauge, ArrowRight, BookOpen, Layers } from 'lucide-react';
import Base from '@/layouts/Base.astro';
import BenchOverview from '@/components/home/BenchOverview.astro';
import CodeBlocks from '@/components/CodeBlocks.astro';
import readme from '@/generated/readme.json';
import { sets } from '../../docs.manifest.mjs';
import { headline, fmt, scene, value, startupLead } from '@/lib/perf';
import { repoUrl } from '@/lib/shared';
import { publishedVersion, workspaceVersion } from '@/lib/repo';
import { codeBlock, codeTabs } from '@/lib/highlight';
import { available as hasWindows } from '@/lib/perf-windows';

const published = await publishedVersion();
const version = published ?? workspaceVersion();
const icons = { Box, FileCode, MonitorSmartphone, SquareTerminal, Gauge } as const;
const h = headline();
const heavy = scene('heavy');

const samples = await codeTabs(
  [
    { code: readme.samples.rust, lang: 'rust', title: 'counter.rs' },
    { code: readme.samples.luau, lang: 'luau', title: 'app.luau' },
  ],
  'hero',
);
const agentCode = await codeBlock({
  code: `claude mcp add zgx -- zgx inspect mcp\nclaude mcp add --transport http zgx-docs https://zgx.zeron.sh/api/mcp\nzgx inspect tree --depth 2\nzgx inspect click '"Add"'\nzgx inspect frames 5`,
  lang: 'sh',
  title: 'terminal',
});

// README's features read on from their bold lead: alone, each starts a sentence.
const sentence = (html: string) => {
  const s = html.replace(/^\(([^)]*)\):\s*/, '$1: ');
  return /^[a-z]/.test(s) ? s[0].toUpperCase() + s.slice(1) : s;
};
const figures = [
  { label: 'CPU while idle', value: `${fmt(value(heavy, 'zgx', 'idle', 'cpu_percent_one_core')!, 2)}%` },
  { label: 'CPU, heavy dashboard', value: h.cards[0].value, note: `GPUI Fast ${fmt(value(heavy, 'gpui-fast', 'both', 'cpu_percent_one_core')!, 1)}%` },
  { label: 'Frames over 25 ms, at most', value: h.cards[2].value, note: `rivals ${h.cards[2].detail[0].text}` },
];
// Launch to first content, when the published run measured it.
const launch = startupLead();
if (launch)
  figures.unshift({
    label: 'Launch to first content',
    value: `${fmt(launch.content, 0)} ms`,
    note: `${fmt(launch.sooner, 0)} ms sooner than GPUI Fast, ${Math.round(launch.fewer * 100)}% fewer instructions`,
  });
// Primitives an app is built from, each with the page that shows it.
const primitives = [
  { title: 'zgx new', text: 'Five app templates, clean under check, lint, audit and test.', href: '/luau/new-app' },
  { title: 'zgx test', text: 'Tests in Luau, against the app mounted headless.', href: '/luau/testing' },
  { title: 'Routing', text: 'Named routes, back and forward, deep links, modal routes.', href: '/luau/routing' },
  { title: 'Live data', text: 'ui.resource, ui.paged and ui.socket, with cancelling and reconnects.', href: '/luau/data' },
  { title: 'Plugins', text: 'Add, filter and replace, with grants declared in zgx.json.', href: '/luau/plugins' },
  { title: 'Localized text', text: 'ICU messages that follow the locale, the file and their arguments.', href: '/luau/localized-text' },
  { title: 'Files', text: 'Drops from outside the window, and uploads with progress.', href: '/luau/data#the-clipboard-and-files' },
  { title: 'Notifications', text: 'System notifications and icon badges on all three platforms.', href: '/luau/windows#notifications-and-badges' },
  { title: '3D', text: 'glTF models with animation and skins, image-based light, orbit controls.', href: '/luau/reference/3d' },
];
const navName = (dir: string, title: string) => (dir === 'rust' ? 'Rust' : dir === 'luau' ? 'Luau' : title);
---

<Base title="zgx: native interfaces in Rust and Luau" description={readme.lede} image="/og/index.png" bare>
  <a href="#main" class="skip">Skip to content</a>
  <header class="top">
    <div class="top-row">
      <a href="/" class="brand" aria-label="zgx home">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="6" fill="var(--color-signal)"></rect>
          <path d="M7.5 8h9l-9 8h9" fill="none" stroke="var(--color-paper)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>zgx</span>
      </a>
      <nav aria-label="Documentation" class="top-nav">
        {
          sets.map((set) => {
            const Icon = icons[set.icon as keyof typeof icons];
            return (
              <a href={`/${set.dir}`}>
                <Icon size={15} strokeWidth={1.7} aria-hidden="true" />
                {navName(set.dir, set.title)}
              </a>
            );
          })
        }
      </nav>
      <div class="top-actions">
        <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch to dark theme">
          <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
        </button>
        <a href={repoUrl} class="btn btn-quiet">GitHub</a>
        <a href="/rust/getting-started" class="btn btn-primary">Get started</a>
      </div>
    </div>
  </header>

  <main id="main" class="frame">
    <section class="split hero" aria-labelledby="hero-title">
      <div class="copy">
        <a class="tag" href="/rust/changelog">
          <span class="tag-mark">{published ? 'New' : 'Latest'}</span>
          {published ? `zgx ${version} is on crates.io` : `zgx ${version}`}
          <ArrowRight size={13} aria-hidden="true" />
        </a>
        <h1 id="hero-title" class="lead">
          <strong>Native interfaces that do no work when nothing changes.</strong>{' '}
          <span>Write them in Rust or Luau; zgx repaints only what changed.</span>
        </h1>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href="/rust/getting-started">Start in Rust</a>
          <a class="btn btn-lg" href="/luau/getting-started">Start in Luau</a>
        </div>
        <dl class="specs">
          <div><dt>Runs on</dt><dd>macOS, Windows, Linux</dd></div>
          <div><dt>Draws with</dt><dd>Metal, Direct3D 12, Vulkan</dd></div>
          <div><dt>License</dt><dd>MIT</dd></div>
        </dl>
      </div>
      <div class="panel">
        <div class="panel-inner">
          <Fragment set:html={samples} />
          <p class="panel-note">The same counter, twice. Save the Luau file and the window updates with its count kept.</p>
        </div>
      </div>
    </section>

    <section class="split perf reveal" aria-labelledby="perf-title">
      <div class="copy">
        <p class="label"><span class="label-icon" aria-hidden="true"><Gauge size={14} strokeWidth={1.8} /></span>Performance</p>
        <h2 id="perf-title" class="lead">
          <strong>The least CPU in {h.ledCpu} of {h.tests} tests.</strong>{' '}
          <span>Against GPUI Fast, MyGo and Rune: the same scenes, from one workload, on one Mac.</span>
        </h2>
        <dl class="figures">
          {
            figures.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd class="figure">{f.value}</dd>
                {f.note && <dd class="figure-note">{f.note}</dd>}
              </div>
            ))
          }
        </dl>
        <div class="more-row">
          <a class="more" href="/performance">Every scene and metric <ArrowRight size={14} aria-hidden="true" /></a>
          {hasWindows && <a class="more" href="/performance/windows">On Windows <ArrowRight size={14} aria-hidden="true" /></a>}
        </div>
      </div>
      <div class="panel">
        <BenchOverview />
      </div>
    </section>

    <section class="split caps reveal" aria-labelledby="caps-title">
      <div class="copy">
        <p class="label"><span class="label-icon" aria-hidden="true"><Layers size={14} strokeWidth={1.8} /></span>Capabilities</p>
        <h2 id="caps-title" class="lead">
          <strong>Everything a desktop app needs.</strong>{' '}
          <span>Layout as CSS does it, shaped and editable text, a GPU renderer, the platform's services and accessibility.</span>
        </h2>
      </div>
      <div class="rows">
        {
          readme.features.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.title}
                <span class="plus" aria-hidden="true" />
              </summary>
              <p set:html={sentence(f.html)} />
            </details>
          ))
        }
      </div>
    </section>

    <section class="prims reveal" aria-labelledby="prims-title">
      <p class="label" id="prims-title"><span class="label-icon" aria-hidden="true"><Layers size={14} strokeWidth={1.8} /></span>Building blocks</p>
      <ul class="prim-grid">
        {
          primitives.map((p) => (
            <li>
              <a href={p.href}>
                <span class="prim-title">{p.title}</span>
                <span class="prim-text">{p.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="split agents reveal" aria-labelledby="agents-title">
      <div class="copy">
        <p class="label"><span class="label-icon" aria-hidden="true"><SquareTerminal size={14} strokeWidth={1.8} /></span>Devtools</p>
        <h2 id="agents-title" class="lead">
          <strong>Built to be driven by agents.</strong>{' '}
          <span><code>zgx inspect</code> reads a running app's tree, state and frame costs, and clicks, types and presses keys by the same targets its tests use. Over MCP, any agent can drive it, and <a href="/devtools/docs-mcp">search these docs</a>.</span>
        </h2>
        <a class="more" href="/devtools">Devtools <ArrowRight size={14} aria-hidden="true" /></a>
      </div>
      <div class="panel">
        <div class="panel-inner">
          <Fragment set:html={agentCode} />
        </div>
      </div>
    </section>

    <section class="index reveal" aria-labelledby="index-title">
      <p class="label" id="index-title"><span class="label-icon" aria-hidden="true"><BookOpen size={14} strokeWidth={1.8} /></span>Documentation</p>
      <ul class="index-rows">
        {
          sets.map((set) => {
            const Icon = icons[set.icon as keyof typeof icons];
            return (
              <li>
                <a href={`/${set.dir}`}>
                  <span class="index-icon" aria-hidden="true">
                    <Icon size={16} strokeWidth={1.7} />
                  </span>
                  <span class="index-title">{set.title}</span>
                  <span class="index-desc">{set.description}</span>
                  <ArrowRight size={16} className="index-arrow" aria-hidden="true" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-row">
      <div class="foot-brand">
        <span class="brand">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="6" fill="var(--color-signal)"></rect>
            <path d="M7.5 8h9l-9 8h9" fill="none" stroke="var(--color-paper)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>zgx</span>
        </span>
        <p>Native interfaces in Rust and Luau.</p>
      </div>
      <nav aria-label="Docs" class="foot-col">
        <p class="foot-head">Docs</p>
        {sets.map((set) => <a href={`/${set.dir}`}>{set.title}</a>)}
      </nav>
      <nav aria-label="Start" class="foot-col">
        <p class="foot-head">Start</p>
        <a href="/rust/getting-started">In Rust</a>
        <a href="/luau/getting-started">In Luau</a>
        <a href="/luau/coming-from-react">Coming from React</a>
        <a href="/devtools/cli">CLI reference</a>
      </nav>
      <nav aria-label="Project" class="foot-col">
        <p class="foot-head">Project</p>
        <a href={repoUrl}>GitHub</a>
        <a href="/rust/changelog">Changelog</a>
        <a href="https://crates.io/crates/zgx">crates.io</a>
        <a href="/llms.txt">llms.txt</a>
      </nav>
    </div>
    <p class="foot-base">MIT licensed.</p>
  </footer>
  <CodeBlocks />
</Base>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    const sync = () => {
      const dark = document.documentElement.classList.contains('dark');
      button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    sync();
    button.addEventListener('click', () => {
      const dark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.classList.toggle('light', !dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      sync();
    });
    // Sections fade in as they come into view.
    const seen = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('shown');
        seen.unobserve(entry.target);
      }
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => seen.observe(el));
  })();
</script>
<noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

<style>
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }

  /* ---- Header ---- */
  .top {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--color-paper) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .top-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 3.75rem;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .top-nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }
  .top-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 150ms ease-out;
  }
  .top-nav a:hover {
    color: var(--color-ink);
  }
  .top-actions {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: 0.5rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.5rem;
    color: var(--color-ink-2);
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }
  .icon-btn:hover {
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
  }
  :global(.dark) .sun,
  :global(html:not(.dark)) .moon {
    display: none;
  }
  @media (max-width: 960px) {
    .top-row {
      grid-template-columns: auto 1fr;
    }
    .top-nav,
    .top-actions .btn-quiet {
      display: none;
    }
  }

  /* ---- Controls ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.1rem;
    padding: 0 0.85rem;
    border: 1px solid var(--color-hairline-strong);
    border-radius: 0.5rem;
    background: var(--color-surface);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: border-color 150ms ease-out, background-color 150ms ease-out;
  }
  .btn:hover {
    border-color: color-mix(in oklab, var(--color-ink) 32%, transparent);
  }
  .btn-primary {
    border-color: transparent;
    background: var(--color-signal);
    color: var(--color-fd-primary-foreground);
  }
  .btn-primary:hover {
    border-color: transparent;
    background: color-mix(in oklab, var(--color-signal) 88%, var(--color-ink));
  }
  .btn-quiet {
    border-color: transparent;
    background: transparent;
    color: var(--color-ink-2);
  }
  .btn-quiet:hover {
    border-color: transparent;
    color: var(--color-ink);
  }
  .btn-lg {
    height: 2.5rem;
    padding: 0 1.1rem;
    font-size: 0.9375rem;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: color 150ms ease-out, gap 150ms ease-out;
  }
  .more:hover {
    gap: 0.5rem;
    color: var(--color-signal);
  }
  .more-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  /* ---- The ruled column ---- */
  .frame {
    max-width: 80rem;
    margin-inline: auto;
    border-inline: 1px solid var(--color-hairline);
  }
  .frame > section + section {
    border-top: 1px solid var(--color-hairline);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.25rem, 3.5vw, 2.75rem);
  }
  @media (max-width: 980px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Leads: a dark first sentence, a lighter one after it, one paragraph. */
  .lead {
    margin: 0;
    font-size: clamp(1.5rem, 2.2vw, 1.75rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .lead strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .lead span {
    color: var(--color-ink-2);
  }
  .lead code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    letter-spacing: -0.02em;
  }
  h1.lead {
    font-size: clamp(1.9rem, 3vw, 2.35rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .label-icon {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.4rem;
    background: var(--color-signal-soft);
    color: var(--color-signal);
  }

  /* ---- Hero ---- */
  .hero .panel {
    padding: clamp(0.75rem, 1.6vw, 1.25rem);
  }
  .hero .panel :global(.cb-pre) {
    font-size: 0.75rem;
  }
  .hero {
    align-items: center;
    padding-top: clamp(3rem, 7vw, 6rem);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.6rem;
    font-size: 0.8125rem;
    color: var(--color-ink-2);
    transition: color 150ms ease-out;
  }
  .tag:hover {
    color: var(--color-ink);
  }
  .tag-mark {
    padding: 0.15rem 0.45rem;
    border-radius: 0.35rem;
    background: var(--color-signal-soft);
    color: var(--color-signal);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.25rem;
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0.5rem 2.25rem;
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  @media (max-width: 520px) {
    .specs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .specs dt {
    font-size: 0.75rem;
    color: var(--color-fd-muted-foreground);
  }
  .specs dd {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* ---- Product panels ---- */
  .panel {
    border-radius: 1rem;
    background: var(--color-wash);
    padding: clamp(1rem, 3vw, 2.5rem);
  }
  .panel-inner {
    max-width: 40rem;
    margin-inline: auto;
  }
  .panel :global(.cb) {
    margin: 0;
    border-radius: 0.8rem;
    box-shadow: 0 1px 2px color-mix(in oklab, var(--color-ink) 6%, transparent), 0 24px 48px -28px color-mix(in oklab, var(--color-ink) 28%, transparent);
  }
  .panel :global(.cb-pre) {
    font-size: 0.8125rem;
  }
  .panel :global(.bench-card) {
    border-color: transparent;
    box-shadow: 0 1px 2px color-mix(in oklab, var(--color-ink) 6%, transparent), 0 24px 48px -28px color-mix(in oklab, var(--color-ink) 28%, transparent);
  }
  @media (max-width: 640px) {
    /* On a phone the panel is a tint behind its content, not a frame around it. */
    .panel {
      margin-inline: calc(-1 * clamp(1.25rem, 3.5vw, 2.75rem) + 0.5rem);
      padding: 0.5rem;
      border-radius: 0.9rem;
    }
    .panel :global(.bench-card) {
      padding: 0.9rem 0.75rem;
    }
  }
  .panel-note {
    margin: 1rem 0.25rem 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  /* ---- Performance ---- */
  .perf {
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }
  @media (max-width: 980px) {
    .perf {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .figures {
    display: grid;
    gap: 1.6rem;
    margin: 2.5rem 0 0;
  }
  .figures dt {
    font-size: 0.8125rem;
    color: var(--color-ink-2);
