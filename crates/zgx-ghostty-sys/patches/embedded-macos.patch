+test "PageList resize reflow less cols cuts background-only tails" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 10, .rows = 3 });
+    defer s.deinit();
+    const page = s.pages.first.?.page();
+    // Rows 0 and 1: four letters, then spaces to the edge (a TUI's band).
+    // Row 2: seven letters, then background-only cells.
+    for (0..s.rows) |y| {
+        const text: usize = if (y == 2) 7 else 4;
+        for (0..s.cols) |x| {
+            const rac = page.getRowAndCell(x, y);
+            rac.cell.* = if (x < text) .{
+                .content_tag = .codepoint,
+                .content = .{ .codepoint = .{ .data = 'A' + @as(u21, @intCast(x)) } },
+            } else if (y == 2) .{
+                .content_tag = .bg_color_rgb,
+                .content = .{ .color_rgb = .{ .r = 1, .g = 2, .b = 3 } },
+            } else .{
+                .content_tag = .codepoint,
+                .content = .{ .codepoint = .{ .data = ' ' } },
+            };
+        }
+    }
+
+    try s.resize(.{ .cols = 5, .reflow = true });
+    // The bands fit: a row each. The long row wraps once, its tail cut.
+    try testing.expectEqual(@as(usize, 4), s.totalRows());
+    var it = s.rowIterator(.right_down, .{ .screen = .{} }, null);
+    const firsts = [_]u21{ 'A', 'A', 'A', 'F' };
+    var y: usize = 0;
+    while (it.next()) |offset| : (y += 1) {
+        const rac = offset.rowAndCell();
+        const cells = offset.node.page().getCells(rac.row);
+        try testing.expectEqual(firsts[y], cells[0].content.codepoint.data);
+        try testing.expectEqual(y == 2, rac.row.wrap);
+    }
+    try testing.expectEqual(@as(usize, 4), y);
+}
