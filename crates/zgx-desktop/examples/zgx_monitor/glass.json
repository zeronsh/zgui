{
	// Dark glass, as the terminal's: the window's blur shows through the tint,
	// and foregrounds are translucent white so they take the colour of what
	// is behind the glass, as AppKit's vibrant labels do.
	"name": "monitor-glass",
	"type": "dark",
	"extends": "zgx-dark",
	"tokens": {
		"glass.tint": "#13141873",
		"text": {
			"primary": "#ffffffeb",
			"secondary": "#ffffffa6",
			"tertiary": "#ffffff66",
			"disabled": "#ffffff38"
		},
		"hover": "#ffffff0a",
		"border.subtle": "#ffffff0d",
		"border.strong": "#ffffff26",
		"accent": "#a99cff",
		"success": "#4fd69a",
		"danger": "#ff7a6b",
		// The interface's typeface (the host registers it).
		"font.sans": "Geist",
		// Each panel's card: a little darker than the window, still glass.
		"monitor.panel": "#0a0b0e4d",
		"monitor.wash": "#ffffff0f",
		// A hue per series, bright enough for the dark glass.
		"monitor.cpu": "#5b9cf2",
		"monitor.gpu": "#f08a4b",
		"monitor.memory": "#3cc492"
	}
}
