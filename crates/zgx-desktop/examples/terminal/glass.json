{
	// Merino Dark semantic colors from Rex Beta's bundled themes.json.
	// appearance.luau selects the native Glass or opaque material path.
	"name": "terminal-glass",
	"type": "dark",
	"extends": "zgx-dark",
	"tokens": {
		"glass.tint": "#0c0e1180",
		"text": {
			"primary": "#e6edf3",
			"secondary": "#82878c",
			"tertiary": "#666a6f",
			"disabled": "#666a6f80"
		},
		"hover": "#e6edf30b",
		"border.subtle": "#2e3135",
		"border.strong": "#424549",
		"surface": { "sunken": "#0c0e11", "base": "#0f1319", "raised": "#1e2023", "overlay": "#1e2023" },
		"success": "#3fb950",
		"accent": "#3485fa",
		"warning": "#d29922",
		"danger": "#ff7b72",
		// SFNS.ttf's installed English family on macOS (San Francisco).
		"font.sans": "System Font",
		// Opaque pane surface; terminal pixels use the host's terminal background.
		"terminal.canvas": "#0c0e11",
		"terminal.surface_raised": "#1e2023",
		"terminal.surface_subtle": "#131519",
		"terminal.terminal_bg": "#0d1117",
		"terminal.pane": "#0f1319",
		// The native reference has no ring around its active pane.
		"terminal.ring": "#2e3135",
		"terminal.wash": "#e6edf313",
		// Frosted glass under the active tab and agent, clearer than the
		// wash; a faint one under the pointer.
		"terminal.glass": "#ffffff1a",
		"terminal.selection_line": "#ffffff0d",
		"terminal.glass_hover": "#ffffff0d",
		// A tab's icon tiles, and the strip's drop and slot highlights.
		"terminal.tile_bg": "#222427",
		"terminal.tile_dim": "#22242780",
		"terminal.tile_line": "#424549",
		"terminal.drop": "#ffffff1f",
		"terminal.slot": "#ffffff0f",
		"terminal.slot_line": "#ffffff29",
		// Context menus: a darker frost than the window's.
		"terminal.menu.bg": "#1e2023e6",
		"terminal.menu.line": "#424549",
		"terminal.menu.hover": "#e6edf313",
		"terminal.menu.separator": "#2e3135",
		"terminal.menu.shadow": "0 6 18 0 #00000040",
		// Buttons, switches, sheets and labels (components/kit.luau).
		"terminal.bright": "#ffffff",
		"terminal.on_fill": "#ffffff",
		"terminal.error_text": "#ff7b72",
		"terminal.control_hover": "#e6edf30b",
		"terminal.button.hover": "#e6edf313",
		"terminal.button.line": "#2e3135",
		"terminal.primary.bg": "#2f81f7",
		"terminal.primary.hover": "#3485fa",
		"terminal.primary.solid": "#2f81f7",
		"terminal.danger.bg": "#da3633",
		"terminal.danger.hover": "#ff7b72",
		"terminal.switch.off": "#ffffff1f",
		"terminal.switch.off_hover": "#ffffff29",
		"terminal.switch.knob": "#ffffff",
		"terminal.switch.knob_shadow": "0 1 3 0 #00000059",
		"terminal.scrim": "#0000004d",
		"terminal.scrim_light": "#0000002e",
		"terminal.sheet.bg": "#1e2023f2",
		"terminal.sheet.line": "#424549",
		"terminal.sheet.shadow": "0 18 48 0 #00000080",
		"terminal.palette.bg": "#00000000",
		"terminal.palette.line": "#ffffff1f",
		"terminal.palette.shadow": "0 24 64 0 #00000099",
		"terminal.key.bg": "#222427",
		"terminal.key.line": "#2e3135",
		"terminal.chip.bg": "#e6edf305",
		"terminal.chip.line": "#2e3135",
		"terminal.card.bg": "#131519",
		"terminal.card.line": "#2e3135",
		"terminal.grip.bg": "#5a5c6440",
		"terminal.grip.line": "#ffffff1a",
		"terminal.grip.shadow": "0 2 8 0 #00000033",
		"terminal.grip.dot": "#ffffff99",
		"terminal.moving": "#ffffff59",
		"terminal.footer": "#ffffff05",
		"terminal.field.bg": "#222427",
		"terminal.field.line": "#2e3135",
		"terminal.field.editing": "#0c0e11",
		"terminal.field.ring": "#3485fa",
		"terminal.progress": "#3485fa"
	}
}
