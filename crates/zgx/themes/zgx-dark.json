{
	// zgx's built-in dark theme. Every theme of type "dark" (or
	// "high-contrast") that leaves a token out takes it from here.
	"name": "zgx-dark",
	"type": "dark",
	"tokens": {
		"background": "#10141c",
		"surface": {
			"sunken": "#0b0e14",
			"base": "#1a2230",
			"raised": "#232e40",
			"overlay": "#232e40"
		},
		"text": {
			"primary": "#e5edf7",
			"secondary": "#8a9ab0",
			"tertiary": "#66758a",
			"disabled": "#4a5668"
		},
		"border": "#2f3d52",
		"border.subtle": "#222c3c",
		"border.strong": "#46576f",
		"accent": "#5ea5ff",
		"accent.hover": "#7ab5ff",
		"accent.text": "#08111f",
		"danger": "#ff6b6b",
		"warning": "#f5b544",
		"success": "#4cc38a",
		"info": "#62b6f0",
		"selection": "#38629eaa",
		"selection.item": "#2b4468",
		"focus.ring": "{accent}",
		"hover": "#3b527080",
		"pressed": "#5a7aa880",
		"scrollbar": {
			"thumb": "{accent}",
			"thumb.active": "{text.primary}",
			"track": "#2f4058"
		},
		"glass": { "tint": "#10141cb3", "blur": 24 },
		"font": {
			"sans": "sans-serif",
			"mono": "monospace",
			"size": { "xs": 11, "sm": 13, "md": 16, "lg": 18, "xl": 22, "xxl": 28 },
			"line": { "xs": 16, "sm": 18, "md": 22, "lg": 24, "xl": 28, "xxl": 34 },
			"weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
		},
		"radius": { "sm": 4, "md": 6, "lg": 10, "xl": 16, "full": 9999 },
		"space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
		"control.height": 36,
		"shadow": {
			"sm": "0 1 2 0 #00000040",
			"md": "0 4 12 0 #00000059",
			"lg": "0 12 32 0 #00000073"
		},
		"motion": {
			"duration": { "fast": 120, "normal": 200, "slow": 320 },
			"ease": {
				"standard": "cubicBezier(0.2, 0, 0, 1)",
				"enter": "cubicBezier(0, 0, 0, 1)",
				"exit": "cubicBezier(0.3, 0, 1, 1)"
			}
		}
	}
}
