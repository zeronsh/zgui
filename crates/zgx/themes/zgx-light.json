{
	// zgx's built-in light theme. Every theme of type "light" (or
	// "high-contrast-light") that leaves a token out takes it from here.
	"name": "zgx-light",
	"type": "light",
	"tokens": {
		"background": "#f5f6f8",
		"surface": {
			"sunken": "#eceef2",
			"base": "#ffffff",
			"raised": "#ffffff",
			"overlay": "#ffffff"
		},
		"text": {
			"primary": "#1a1f29",
			"secondary": "#5a6474",
			"tertiary": "#858e9c",
			"disabled": "#b3b9c4"
		},
		"border": "#d5dae1",
		"border.subtle": "#e5e8ed",
		"border.strong": "#aeb5c0",
		"accent": "#2563eb",
		"accent.hover": "#1d4fd7",
		"accent.text": "#ffffff",
		"danger": "#d92d20",
		"warning": "#b25e09",
		"success": "#12805c",
		"info": "#0b6bcb",
		"selection": "#2563eb3d",
		"selection.item": "#dce7fd",
		"focus.ring": "{accent}",
		"hover": "#0000000d",
		"pressed": "#0000001a",
		"scrollbar": {
			"thumb": "#00000040",
			"thumb.active": "#00000073",
			"track": "#00000000"
		},
		"glass": { "tint": "#f5f6f8b3", "blur": 24 },
		"font": {
			"sans": "sans-serif",
			"mono": "monospace",
			"size": { "xs": 11, "sm": 13, "md": 16, "lg": 18, "xl": 22, "xxl": 28 },
			"line": { "xs": 16, "sm": 18, "md": 22, "lg": 24, "xl": 28, "xxl": 34 },
			"weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
		},
		"radius": { "sm": 4, "md": 6, "lg": 10, "xl": 16, "full": 9999 },
		"space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
		"control.height": 36,
		"shadow": {
			"sm": "0 1 2 0 #0000001a",
			"md": "0 4 12 0 #00000024",
			"lg": "0 12 32 0 #0000002e"
		},
		"motion": {
			"duration": { "fast": 120, "normal": 200, "slow": 320 },
			"ease": {
				"standard": "cubicBezier(0.2, 0, 0, 1)",
				"enter": "cubicBezier(0, 0, 0, 1)",
				"exit": "cubicBezier(0.3, 0, 1, 1)"
			}
		},
		// On a light window a white button would vanish: controls sit a
		// step down from the surfaces instead.
		"button.bg": "#e8ebf0",
		"input.bg": "{surface.sunken}"
	}
}
